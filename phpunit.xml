<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            SQLite in memory, so `php artisan test` needs no Docker, no MySQL
            and no .env.testing, and can never touch a developer's real data.
            Every module's migrations are discovered by ModuleServiceProvider
            exactly as they are in the app, so the schema under test is the
            real one.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>

        <!--
            Nothing should reach a broker, a mail server or a cache here.

            Each setting is FORCED twice, as <env> and as <server>. Without
            force, PHPUnit only sets a variable the environment does not
            already have, and the Docker app container exports
            QUEUE_CONNECTION=redis. And <env> alone is not enough: PHP copies
            the container's environment into $_SERVER, which Laravel reads
            BEFORE $_ENV, so config('queue.default') stayed 'redis'. Tests
            then queued notifications onto the REAL Redis queue, where the
            dev worker failed them against a test database it cannot see
            (thousands of rows in failed_jobs). Forced in both, a test run
            never reaches the real queue, mail or cache.
        -->
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>

        <!-- Hashing is the slowest thing in an auth test; 4 rounds is plenty. -->
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>

        <!--
            The Workstation assistant (app/Modules/Chloe/Assistant): every
            automated test runs against FakeModel, never the real Gemini
            provider. No network call, no free-tier quota spent, no key
            ever read. See Assistant\FakeModel and ModuleProvider::register().
        -->
        <env name="ASSISTANT_PROVIDER" value="fake"/>
    </php>
</phpunit>
