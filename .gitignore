/vendor
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/node_modules
/public/storage
/public/build
/storage/*.key
/storage/app/uploads
# Laravel 11+'s default local-disk root; DocumentStore/DocumentStore::storeGenerated
# write every upload and generated PDF here.
/storage/app/private
/storage/framework/cache/data/*
# maatwebsite/excel's scratch space, written while building the attendance
# template and while reading an upload.
/storage/framework/cache/laravel-excel/*
# Storage::fake() in the test suite.
/storage/framework/testing
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
# Dompdf's own font cache -- CandidacyAppealController registers the Tahoma
# TTFs from app/Modules/Chloe/Resources/fonts into here at render time; the
# source files are committed, this generated cache is not.
/storage/fonts/*
!.gitkeep
.env
.env.backup
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.idea
/.vscode
.DS_Store

# Editor / OS noise
Thumbs.db
*.swp
*~

# Local-only files (never commit)
.env.testing
storage/app/assistant-evaluate-progress*.json
docs/knowledge/**/*.pdf
docs/knowledge/*.pdf
