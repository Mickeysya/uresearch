[mysqld]
# Fail loudly on bad data instead of silently truncating it. The legacy
# app relied on lax mode -- e.g. writing decision='reviewed' into an ENUM
# that did not contain it. We want that to error, not blank out.
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
