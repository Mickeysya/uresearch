{
  "permissions": {
    "allow": [
      "Bash(docker info *)",
      "Bash(./vendor/bin/sail up *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-remote-writes.py"
          }
        ]
      }
    ]
  }
}
