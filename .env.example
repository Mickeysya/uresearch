APP_NAME="UResearch 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

# Must be set explicitly: Sail's own CLI script (vendor/laravel/sail/bin/sail)
# exports APP_PORT=80 into the shell whenever it isn't already set, which
# overrides docker-compose.yml's default of 8000. Without this line every
# `sail up` binds the app to port 80 instead of 8000, no matter what the
# compose file says.
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Matches docker-compose.yml. Nothing to configure if you used the compose file.
# Hostnames are the docker-compose service names, not 127.0.0.1/localhost --
# the app itself runs in its own container, so it must reach mysql/mailpit
# over the compose network rather than on "its own" loopback.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=uresearch
DB_USERNAME=uresearch
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=database

# Mailpit -- open http://localhost:8025 to read anything the app sends.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@uresearch.utp.edu.my"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# --- Real provider, used only by e2e/prod overrides ---
REAL_SMTP_HOST=smtp.resend.com
REAL_SMTP_PORT=465
REAL_SMTP_USER=resend
REAL_SMTP_PASS=
REAL_MAIL_FROM=noreply@yourdomain.com

REDIS_HOST=redis
REDIS_PORT=6379
