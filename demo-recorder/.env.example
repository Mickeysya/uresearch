# Copy to .env and adjust. Every seeded account's password is "password".

# Where the app and Mailpit are served (as seen from your browser).
BASE_URL=http://localhost:8000
MAILPIT_URL=http://localhost:8025

# One password for every demo account (the seeders use "password").
DEMO_PASSWORD=password

# Staff accounts. Students are not listed: they are the ones
# `nureen:demo-fresh` picks, read from its output on every run.
ADMIN_EMAIL=admin@utp.edu.my
CGS_EMAIL=zulkifly.cgs@utp.edu.my
CHAIR_EMAIL=chair@utp.edu.my
DIRECTOR_EMAIL=director@utp.edu.my

# Pacing. SLOW_MO is Playwright's delay between actions (ms); HOLD is the
# pause after a page loads or an important result appears (ms).
SLOW_MO=250
HOLD=1800
TYPE_DELAY=40
